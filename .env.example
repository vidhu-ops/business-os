# API
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000,https://your-app.onrender.com
FRONTEND_URL=http://localhost:3000
# Internal API for Next.js proxy (not used as OAuth redirect when FRONTEND_URL is set)
API_URL=http://127.0.0.1:8000
# Optional explicit OAuth callback (must match provider app settings). Default: {FRONTEND_URL}/api/v1/oauth/callback
# OAUTH_REDIRECT_URI=https://your-app.onrender.com/api/v1/oauth/callback

# Research & agent LLM keys (server-wide defaults)
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Plan It Out / Business Plan (Validation hub) — Zo proxies MiniMax for hub-reference
ZO_API_KEY=

# Optional browser-side fallbacks for hub-reference (server ZO_API_KEY / ANTHROPIC_API_KEY preferred)
# NEXT_PUBLIC_ZO_API_KEY=
# NEXT_PUBLIC_GEMINI_API_KEY=
# NEXT_PUBLIC_CLAUDE_API_KEY=

# OAuth app credentials (for Integrations → Connect)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Optional: seed integrations without OAuth UI
HUBSPOT_PRIVATE_APP_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
GMAIL_ACCESS_TOKEN=
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=

# Service provider portal — admin notifications & approvals
ADMIN_EMAIL=vidhu@pronto.me
PARTNER_NOTIFY_EMAIL=
PARTNER_ADMIN_KEY=change-me-partner-admin-key

# Freecharge Payment Gateway (https://www.freechargepg.in/developer)
FREECHARGE_MODE=sandbox
FREECHARGE_MERCHANT_ID=
FREECHARGE_SECRET_KEY=
FREECHARGE_AES_KEY=
# Optional — if FCPG provides a separate IV (16 bytes hex)
FREECHARGE_AES_IV=
